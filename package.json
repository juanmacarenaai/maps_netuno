{
  "name": "weezie-map-widget",
  "version": "1.0.0",
  "private": true,
  "description": "Widget de Zoho CRM con Leaflet/OpenStreetMap + proxy Node para consultar ubicaciones NAP (Weezie) cercanas",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node proxy/server.js",
    "dev": "node --watch proxy/server.js",
