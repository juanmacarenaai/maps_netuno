    "build": "node tools/build.mjs",
    "smoke": "node tools/smoke.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "archiver": "^6.0.2",
    "leaflet": "^1.9.4"
  }
}